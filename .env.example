# 复制为 .env 后再启动。正式使用时请替换所有 change-me 值。
MYSQL_DATABASE=researchflow
MYSQL_ROOT_PASSWORD=researchflow-mysql-change-me
REDIS_PASSWORD=researchflow-redis-change-me
RABBITMQ_USERNAME=researchflow
RABBITMQ_PASSWORD=researchflow-rabbit-change-me
AI_INTERNAL_TOKEN=researchflow-ai-token-change-me
JWT_SECRET_KEY=researchflow-jwt-secret-key-change-me-now
JWT_TTL=7200000

# 对外端口；如本机已有同端口服务，可在这里修改。
FRONTEND_PORT=3000
BACKEND_PORT=8080
AI_SERVICE_PORT=8090
MYSQL_PORT=3307
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
