APP_HOST=127.0.0.1
APP_PORT=8090
JAVA_API_BASE_URL=http://127.0.0.1:8080
AI_INTERNAL_TOKEN=researchflow-local-ai-token
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_TEMPERATURE=0.5
DEEPSEEK_MAX_TOKENS=4096
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_RETRY_EXCHANGE=researchflow.document.retry
RABBITMQ_DEAD_LETTER_EXCHANGE=researchflow.document.dlx
RABBITMQ_MAX_RETRIES=3
DOCUMENT_PARSE_QUEUE=document.parse
DOCUMENT_VECTORIZE_QUEUE=document.vectorize
DOCUMENT_VECTOR_DELETE_QUEUE=document.vector.delete
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=researchflow_documents
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_CACHE_DIR=data/models
RAG_TOP_K=5
RAG_MIN_SCORE=0.25
RAG_MAX_CONTEXT_CHARS=12000
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
